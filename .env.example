# Supabase
# Project Settings → API. Service role key is server-only — never expose it
# to the browser or commit it. Anon key is safe for the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js + Google OAuth
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI:
# https://<your-domain>/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (email in/out)
RESEND_API_KEY=
EMAIL_FROM=budget@contemplativesemester.org
# Aditya — receives the weekly digest with approval links
APPROVER_EMAIL=
# Jaycel/Melissa — comma-separated, receive the accountant email on approval
ACCOUNTANT_EMAILS=
# Shared secret for verifying Resend's inbound-email webhook (Svix headers)
RESEND_INBOUND_WEBHOOK_SECRET=

# Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Claude API (receipt OCR + /chat + WhatsApp bot)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=https://budget.contemplativesemester.org
# Bearer token Vercel Cron must present to /api/cron/weekly-digest
CRON_SECRET=
